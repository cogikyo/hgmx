package views

templ Full(site *Site, path, title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href={ site.Static.URL("favicon/favicon.svg") }/>
			<link rel="shortcut icon" href={ site.Static.URL("favicon/favicon.ico") }/>
			<link rel="stylesheet" href={ site.Static.URL("css/main.min.css") }/>
			@templ.Raw(site.App.Head())
			@templ.Raw(site.Scripts.Head())
		</head>
		<body
			hx-boost:inherited="target:#main select:#main swap:'innerHTML strip show:top showTarget:body' transition:true"
			hx-select-oob:inherited="#nav-links:outerMorph"
		>
			<nav id="nav">
				<ul id="nav-links">
					@navLink(path, "/", "Home")
					@navLink(path, "/about", "About")
				</ul>
			</nav>
			<main id="main" hx-history-elt>
				@content
			</main>
		</body>
	</html>
}

templ navLink(current, href, label string) {
	<li>
		<a
			href={ templ.SafeURL(href) }
			if current == href {
				aria-current="page"
			}
		>{ label }</a>
	</li>
}

templ Home() {
	<h1>Home</h1>
	<p>Every route returns the full page; htmx swaps only <code>#main</code> and the nav links.</p>
}

templ About() {
	<h1>About</h1>
	<p>The current nav link is marked on the server with <code>aria-current</code>.</p>
}

templ NotFound() {
	<h1>Not Found</h1>
	<p>No page lives at this address. <a href="/">Go home</a>.</p>
}
